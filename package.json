{
  "name": "herdr-acp",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Client Protocol (ACP) server that drives interactive coding agents running in herdr panes",
  "type": "module",
  "bin": {
    "herdr-acp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "smoke": "node scripts/smoke.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "acp",
    "agent-client-protocol",
    "herdr",
    "claude-code",
    "pi"
  ],
  "author": "Alain Clément",
  "license": "UNLICENSED",
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
